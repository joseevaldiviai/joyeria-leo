---
import '../styles/global.css';

const services = [
  { icon: '✦', title: 'Mejor precio', text: 'Compramos oro de todo tipo y calidad con peso exacto y una propuesta justa.' },
  { icon: '◇', title: 'Prueba segura', text: 'Las pruebas se hacen con ácido que no daña tus piezas ni altera su valor.' },
  { icon: '⌁', title: 'Recojo a domicilio', text: 'Si no puedes visitarnos, coordinamos el recojo en Cochabamba.' },
];

const benefits = ['Pago inmediato', 'Peso exacto', 'Evaluación transparente'];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Joyeria Leo: compramos oro y joyas en Cochabamba con evaluación justa y pago inmediato." />
    <title>Joyeria Leo — El valor de lo que llevas contigo</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Joyeria Leo, inicio">
        <span class="brand-logo"><img src="/logo-referencia.jpeg" alt="Logotipo de Joyería Leo" /></span>
        <span><b>JOYERÍA</b><strong>LEO</strong></span>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#servicios">Servicios</a>
        <a href="#proceso">Cómo funciona</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="header-cta" href="https://wa.me/59171440015" target="_blank" rel="noreferrer">Cotizar por WhatsApp <span>↗</span></a>
    </header>

    <main id="inicio">
      <section class="hero section-shell">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Cochabamba, Bolivia · Atención cercana</p>
          <h1>Compramos oro<br /><em>al mejor precio.</em></h1>
          <p class="hero-intro">De todo tipo y calidad. Peso exacto, evaluación justa y efectivo al momento. Tu oro tiene valor, nosotros lo reconocemos.</p>
          <div class="hero-actions">
            <a class="button button-gold" href="https://wa.me/59171440015" target="_blank" rel="noreferrer">Quiero una tasación <span>↗</span></a>
            <a class="text-link" href="#contacto">Llámanos: 71440015 <span>↗</span></a>
          </div>
          <div class="trust-row">
            <div class="avatar-stack"><i>✓</i><i>⚖</i><i>◆</i></div>
            <p><strong>Pago inmediato · Peso exacto</strong><br /><span>Pruebas con ácido que no dañan tus piezas</span></p>
          </div>
        </div>
        <div class="hero-visual">
          <img class="hero-banner-image" src="/logo-referencia.jpeg" alt="Joyería Leo compra oro en Cochabamba" />
          <div class="hero-banner-overlay"></div>
          <div class="hero-banner-copy"><span>JOYERÍA LEO</span><strong>Tu oro tiene valor.</strong><small>Nosotros lo reconocemos.</small></div>
          <div class="hero-badge">EFECTIVO<br /><b>AL MOMENTO</b></div>
        </div>
      </section>

      <section class="ticker" aria-label="Beneficios">
        <div class="ticker-inner">{benefits.map((benefit) => <span><b>✦</b> {benefit}</span>)}</div>
      </section>

      <section class="services section-shell" id="servicios">
        <div class="section-heading"><p class="eyebrow"><span></span> Lo que hacemos</p><h2>Valoramos lo que<br /><em>para ti importa.</em></h2></div>
        <p class="section-lead">Cada pieza guarda una historia. La miramos con atención, la evaluamos con experiencia y te damos la libertad de decidir.</p>
        <div class="service-grid">
          {services.map((service, index) => <article class:list={["service-card", { featured: index === 0 }]}><span class="service-number">0{index + 1}</span><div class="service-icon">{service.icon}</div><h3>{service.title}</h3><p>{service.text}</p><a href="#contacto" aria-label={`Conoce más sobre ${service.title}`}>Saber más <span>↗</span></a></article>)}
        </div>
      </section>

      <section class="process section-shell" id="proceso">
        <div class="process-image"><img src="/compra-oro.jpeg" alt="Piezas de oro y evaluación de Joyeria Leo" /><div class="image-stamp">LEO<br /><small>DESDE 2015</small></div></div>
        <div class="process-copy"><p class="eyebrow"><span></span> Sin vueltas</p><h2>Así de simple es<br /><em>darle valor a tu oro.</em></h2><div class="steps"><div class="step"><b>01</b><div><h3>Agenda tu visita</h3><p>Escríbenos o solicita nuestro recojo a domicilio.</p></div></div><div class="step"><b>02</b><div><h3>Evaluamos tus piezas</h3><p>Revisamos peso y pureza con una prueba de ácido que no daña tus piezas.</p></div></div><div class="step"><b>03</b><div><h3>Recibe tu pago</h3><p>Obtén una evaluación justa y efectivo al momento.</p></div></div></div></div>
      </section>

      <section class="contact section-shell" id="contacto"><div><p class="eyebrow"><span></span> Estamos para ayudarte</p><h2>¿Tienes oro<br /><em>para valorar?</em></h2></div><div class="contact-box"><p>Cuéntanos qué tienes y recibe una orientación inicial sin compromiso.</p><a class="button button-dark" href="https://wa.me/59171440015" target="_blank" rel="noreferrer">Hablar por WhatsApp <span>↗</span></a><p class="contact-detail">+591 714 40015 · Calle San Martín, casi calle Brasil</p></div></section>
    </main>

    <footer><div class="brand footer-brand"><span class="brand-mark">L</span><span><b>JOYERÍA</b><strong>LEO</strong></span></div><p>Oro con historia. Valor con propósito.</p><p>© {new Date().getFullYear()} Joyeria Leo</p></footer>
  </body>
</html>
